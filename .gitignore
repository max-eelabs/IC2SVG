# Python bytecode and compiled extensions, at any directory depth.
__pycache__/
*.py[cod]
*$py.class
*.so

# Python tool caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# Virtual environments.
.venv/
venv/

# Build and packaging artifacts.
*.egg-info/
.eggs/
*.egg
*.whl
build/
dist/

# Temporary folder of the repo
tmp